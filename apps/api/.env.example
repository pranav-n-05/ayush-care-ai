# Copy to .env for local development. Never commit real secrets.
AYUSH_ENVIRONMENT=development
AYUSH_DATABASE_URL=postgresql+asyncpg://ayushcare:ayushcare_dev_only@localhost:5432/ayushcare
AYUSH_REDIS_URL=redis://localhost:6379/0
AYUSH_JOB_DISPATCHER=inline
# Local HTTP dev only. Production requires true (enforced).
AYUSH_COOKIE_SECURE=false
AYUSH_CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
AYUSH_TRUSTED_ORIGINS=["http://localhost:3000"]
AYUSH_STORAGE_ROOT=./var/storage
